# 复制为 ci/ci.env（已 gitignore）或放到 ~/.chimo/ci.env / ~/.jenkins/chimo-ci.env
# 也可在 Jenkins 凭据里注入同名环境变量。

# Cloudflare R2（upload_r2.py）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
# R2_BUCKET=test-ci

# Apple App Store Connect API（iOS export / upload）
# Key ID + Issuer；.p8 放到打包机 ~/.appstoreconnect/private_keys/AuthKey_<KEYID>.p8
APP_STORE_API_KEY=
APP_STORE_API_ISSUER=
# 可选：.p8 的绝对路径（不设则按 Apple 默认目录查找）
# APP_STORE_API_KEY_PATH=/Users/jenkins/.appstoreconnect/private_keys/AuthKey_XXXX.p8

# iOS 签名 keychain（Jenkins 无界面构建时必填，否则常见 errSecInternalComponent）
# KEYCHAIN_PASSWORD=拥有签名私钥的 keychain 密码；通常是当前 macOS 用户登录密码
# KEYCHAIN_PATH=/Users/doufeng/Library/Keychains/login.keychain-db
# 若 chimo 未配置，脚本也会尝试从旧的 joyride ci.env 迁移读取这两个变量
